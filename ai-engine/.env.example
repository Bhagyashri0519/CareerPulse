# AI Engine environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to Git.

AI_ENGINE_PORT=8000

# LLM provider API key (e.g. OpenAI, Gemini, etc.)
LLM_API_KEY=replace_with_your_llm_api_key
LLM_MODEL=gpt-4o-mini

# Backend API base URL (for callbacks or health checks)
BACKEND_URL=http://localhost:4000/api/v1

# Environment
ENVIRONMENT=development
LOG_LEVEL=info
