{
  "name": "careerpulse",
  "version": "1.0.0",
  "private": true,
  "description": "CareerPulse — AI-Powered Career Development Platform",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:all": "bash scripts/run-dev.sh",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "preview": "npm --prefix frontend run preview",
    "preview:frontend": "npm --prefix frontend run preview",
    "typecheck": "npm --prefix frontend run typecheck && npm --prefix backend run typecheck",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "test": "npm --prefix backend run test",
    "test:backend": "npm --prefix backend run test",
    "db:seed": "cd backend && NODE_PATH=./node_modules npx ts-node --project tsconfig.json --transpile-only ../database/scripts/seed.ts",
    "setup:env": "bash scripts/setup-env.sh",
    "health": "bash scripts/check-health.sh"
  },
  "keywords": [
    "careerpulse",
    "career-development",
    "ai",
    "react",
    "express",
    "fastapi"
  ],
  "author": "CareerPulse Team",
  "license": "MIT"
}
